{
  "version": 2,
  "builds": [
    {
      "src": "facility_495177_flask_app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "facility_495177_flask_app.py",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Pragma": "no-cache",
        "Expires": "0"
      }
    }
  ],
  "env": {
    "PYTHONPATH": "."
  }
}